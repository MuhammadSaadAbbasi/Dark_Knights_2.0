# Backend only. Never put provider secrets in apps/web or apps/android.
APP_NAME=CivicPulse AI API
DATABASE_URL=sqlite:///./civicpulse.db
CORS_ORIGINS=http://localhost:5173
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
MAX_UPLOAD_MB=8
UPLOAD_DIR=uploads
AI_TIMEOUT_SECONDS=15
AI_RETRIES=1
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=60
# The first admin account is created on startup if it does not already exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-development-password
# Set true only for a controlled hackathon/demo environment. Keep false in production.
DEMO_LOGIN_ENABLED=false
